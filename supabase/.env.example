# Hosted functions provide URL and Service Role values. Set one public client key locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Legacy/local projects may provide SUPABASE_ANON_KEY instead.
# SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Server-only Stripe secrets. Never expose them through a frontend build variable.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Canonical frontend URL used to build all Checkout and Customer Portal redirects.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed to call Edge Functions.
ALLOWED_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Signed URL lifetime is bounded to 60-900 seconds by the function.
SIGNED_URL_TTL_SECONDS=300
